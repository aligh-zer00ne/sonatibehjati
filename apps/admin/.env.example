# Relative same-origin endpoint; configure the equivalent reverse proxy in production.
VITE_API_URL=/api/admin
# Server-only Vite development/preview proxy setting; never use VITE_ for secrets.
API_PROXY_TARGET=http://localhost:4000

# Actual storefront origin used by the product preview modal
VITE_STOREFRONT_URL=http://localhost:3000

# Client-facing Neshan Web map key; restrict it to your deployed domain in Neshan.
# Set before building the admin. Do not use a server web-service key here.
VITE_NESHAN_MAP_KEY=
