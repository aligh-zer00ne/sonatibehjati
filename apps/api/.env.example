NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://behjati:development_only@localhost:3306/behjati
STOREFRONT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
USER_ACCESS_TOKEN_SECRET=
USER_REFRESH_TOKEN_SECRET=
ADMIN_ACCESS_TOKEN_SECRET=
ADMIN_REFRESH_TOKEN_SECRET=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
SHIPPING_COST=60000
# Optional persistent directory. Default: uploads/ under the API working directory.
UPLOAD_DIRECTORY=
# Auth: use npm run setup:auth for local random secrets; never reuse these across roles.
OTP_HASH_SECRET=
AUTH_PROXY_SECRET=
AUTH_TRUST_PROXY_HEADERS=false
# mock is allowed only outside production. Production must select melipayamak.
# Disable customer login entirely for the owner-only gateway review release.
CUSTOMER_AUTH_ENABLED=true
ADMIN_PAYMENT_TEST_ENABLED=false
SMS_PROVIDER=mock
# Temporary development-only login code; empty restores random development OTPs.
# Ignored in test/production. Real SMS is sent only in production.
DEV_OTP_CODE=12345
MELI_PAYAMAK_HOSTNAME=console.melipayamak.com
MELI_PAYAMAK_PATH=/api/send/shared/{apiKey}
MELI_PAYAMAK_API_KEY=
MELI_PAYAMAK_OTP_BODY_ID=

# SEP gateway. disabled preserves the current preview until real SMS and production access are ready.
PAYMENT_PROVIDER=disabled
SEP_TERMINAL_ID=
SEP_CALLBACK_ORIGIN=https://sonatibehjati.ir
# Local tests only; never configure a substitute endpoint in production.
SEP_TEST_BASE_URL=

# Temporary main-storefront payment testing only: fixed OTP 123456, no SMS.
CHECKOUT_PAYMENT_TEST_ENABLED=false
