NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:4000/graphql
CATALOG_SOURCE=mock
# Server-only; must match the API configuration. Never use NEXT_PUBLIC for this key.
STOREFRONT_ORIGIN=http://localhost:3000
AUTH_PROXY_SECRET=
# Enable only behind a trusted proxy which overwrites client-supplied forwarding headers.
AUTH_TRUST_PROXY_HEADERS=false

# Temporary main-storefront payment testing only: fixed OTP 123456, no SMS.
CHECKOUT_PAYMENT_TEST_ENABLED=false

# Optional SEO controls. Production + API catalog is indexable by default.
# Set false on a publicly accessible staging deployment, then rebuild/restart.
# SEO_INDEXING_ENABLED=false
# Optional ownership tokens from Google Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
