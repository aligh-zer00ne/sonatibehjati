{
  "name": "behjati",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:storefront\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:storefront": "npm run dev -w @behjati/storefront",
    "dev:admin": "npm run dev -w @behjati/admin",
    "dev:api": "npm run dev -w @behjati/api",
    "lint": "eslint .",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "build": "node scripts/run-workspaces.mjs build",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:generate": "npm run db:generate -w @behjati/api",
    "db:migrate": "npm run db:migrate -w @behjati/api",
    "db:seed": "npm run db:seed -w @behjati/api",
    "photos:import": "npm run photos:import -w @behjati/api",
    "dev:bun": "bun run dev",
    "check": "npm run codegen && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:home": "node scripts/verify-home.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "verify:commerce": "node scripts/verify-commerce.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:auth-ui": "node scripts/verify-auth-ui.mjs",
    "verify:checkout": "node scripts/verify-checkout.mjs",
    "verify:checkout-ui": "node scripts/verify-checkout-ui.mjs",
    "setup:auth": "node scripts/setup-auth-env.mjs",
    "verify:account": "node scripts/verify-account.mjs",
    "verify:account-ui": "node scripts/verify-account-ui.mjs",
    "setup:admin": "node scripts/setup-admin-env.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "verify:admin-auth": "node scripts/verify-admin-auth.mjs",
    "verify:admin": "node scripts/verify-admin-commerce.mjs",
    "verify:admin-ui": "node scripts/verify-admin-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/client-preset": "^5.2.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-resolvers": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "6.4.3",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.15",
    "npm": ">=10",
    "bun": ">=1.3"
  },
  "overrides": {
    "vite": "6.4.3",
    "deepmerge-ts": "8.0.0"
  }
}
